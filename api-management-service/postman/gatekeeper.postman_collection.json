    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Public. Saves the token into platformToken / tenantToken / gatewayToken based on the returned role."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const res = pm.response.json();",
                  "    const vars = { PLATFORM_ADMIN: 'platformToken', TENANT_ADMIN: 'tenantToken', GATEWAY_SERVICE: 'gatewayToken' };",
                  "    const role = (res.role || '').replace(/^ROLE_/, '');",
                  "    const key = vars[role];",
                  "    if (key) {",
                  "        pm.collectionVariables.set(key, res.token);",
                  "        console.log('Saved token to ' + key);",
                  "    }",
                  "    if (res.organizationId) pm.collectionVariables.set('organizationId', res.organizationId);",
                  "}"
                ]
              }
            }
          ]
        }
      ]
